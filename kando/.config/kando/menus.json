{
  "version": "3.0.0",
  "menus": [
    {
      "root": {
        "name": "Exemple de Menu",
        "icon": "award_star",
        "iconTheme": "material-symbols-rounded",
        "type": "root",
        "activateWorkflow": {
          "quickSelectKey": "Backspace",
          "actions": [
            {
              "type": "close-menu"
            }
          ]
        },
        "children": [
          {
            "name": "TerminalTerminal",
            "icon": "gnometerminal",
            "iconTheme": "simple-icons",
            "type": "button",
            "selectWorkflow": {
              "actions": [
                {
                  "type": "inhibit-shortcuts"
                },
                {
                  "type": "close-menu"
                },
                {
                  "type": "execute-macro",
                  "macro": [
                    {
                      "type": "keyDown",
                      "delay": 10,
                      "key": "MetaLeft"
                    },
                    {
                      "type": "keyDown",
                      "delay": 10,
                      "key": "KeyI"
                    },
                    {
                      "type": "keyUp",
                      "delay": 10,
                      "key": "KeyI"
                    },
                    {
                      "type": "keyUp",
                      "delay": 10,
                      "key": "MetaLeft"
                    }
                  ]
                }
              ]
            }
          },
          {
            "name": "Nautilus",
